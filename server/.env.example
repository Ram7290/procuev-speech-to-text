# --- server config (copy to .env and fill in) ---

PORT=8080

# PostgreSQL: local docker (docker compose up -d postgres) or Neon free tier in the cloud
# Local docker listens on host port 5433 to avoid clashing with a local PostgreSQL install.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/procuev

# STT engine: "gemini" (Gemini Live API, needs a free key) or "local" (self-hosted whisper.cpp)
STT_PROVIDER=gemini
GEMINI_API_KEY=your_key_from_aistudio.google.com
GEMINI_MODEL=gemini-3.5-transcribe-live

# --- only needed when STT_PROVIDER=local (Phase 2) ---
# Run scripts/setup-whisper.ps1 first, then adjust per OS / chosen model.
# base = best live latency on CPU; small = better Hindi accuracy, ~4x slower.
# WHISPER_BIN=bin/Release/whisper-cli.exe
# WHISPER_MODEL=models/ggml-base.bin
# VAD_RMS_THRESHOLD=500
